# Any Video Downloader Bot - Environment Configuration
# Copy to .env and fill in your values

# =============================================================================
# TELEGRAM BOT CONFIGURATION
# =============================================================================
BOT_TOKEN=your_bot_token_here
ADMIN_USER_IDS=123456789,987654321

# =============================================================================
# RESOURCE GOVERNOR CONFIGURATION
# =============================================================================
# Resource mode: auto-shared | auto-dedicated | manual
RESOURCE_MODE=auto-shared

# Safety headroom (fraction of total resources to keep free)
MEMORY_SAFETY_HEADROOM=0.15
DISK_SAFETY_HEADROOM_GB=0
DISK_SAFETY_HEADROOM_FRACTION=0.08
CPU_SAFETY_HEADROOM=0.1

# Maximum concurrent operations (0 = automatically governed by resources)
MAX_CONCURRENT_EXTRACTIONS=0
MAX_CONCURRENT_DOWNLOADS=0
MAX_CONCURRENT_MERGES=0
MAX_CONCURRENT_UPLOADS=0

# PER ACTIVE DOWNLOAD PROCESS bandwidth ceiling in bytes/sec; not aggregate bot-wide (0 = unlimited)
BANDWIDTH_CEILING=0

# =============================================================================
# STORAGE CONFIGURATION
# =============================================================================
DATA_DIR=./data
JOBS_DIR=./data/jobs
DATABASE_PATH=./data/bot.db

MAX_JOB_SIZE_BYTES=0
# 0 = automatic adaptive capacity; positive values impose a hard ceiling
SCHEDULER_MAX_WORKERS=0
SCHEDULER_RETRY_SECONDS=10
PROCESS_TERMINATE_GRACE_SECONDS=5

# =============================================================================
# EXTRACTION CONFIGURATION
# =============================================================================
YTDLP_TIMEOUT=60
# Per-request network timeout and conservative extractor retries
YTDLP_SOCKET_TIMEOUT=15
YTDLP_EXTRACTOR_RETRIES=2
# Retry one eligible failed metadata request with curl-cffi browser impersonation
YTDLP_IMPERSONATION_FALLBACK=true
YTDLP_IMPERSONATE_TARGET=chrome
# Optional operator-mounted Netscape cookie file; leave empty for public access
YTDLP_COOKIES_FILE=
# Domain scope for single cookie file (required when YTDLP_COOKIES_FILE is set, e.g. youtube.com or comma-separated)
YTDLP_COOKIE_DOMAINS=
# Optional operator-mounted multi-profile session config file
YTDLP_PROFILES_FILE=

MAX_COLLECTION_DEPTH=3
MEDIA_SESSION_TTL=1800
MAX_COLLECTION_ITEMS=50
MAX_BATCH_URLS=10

# =============================================================================
# MAINTENANCE AND RETENTION CONFIGURATION
# =============================================================================
MAINTENANCE_INTERVAL_SECONDS=900
ORPHAN_GRACE_HOURS=24
JOB_HISTORY_DAYS=30
CACHE_RETENTION_DAYS=90
UI_DRAFT_TTL_HOURS=24
BACKUP_RETENTION_COUNT=5

# =============================================================================
# DOWNLOAD CONFIGURATION
# =============================================================================
DOWNLOAD_TIMEOUT=3600
MAX_RETRIES=3
RESUME_ENABLED=true

# =============================================================================
# TELEGRAM API CONFIGURATION
# =============================================================================
# Safe default: use Telegram's cloud Bot API
USE_LOCAL_API=false
# Docker-safe example hostname; host-native runs may explicitly use http://localhost:8081
LOCAL_API_BASE_URL=http://telegram-local-api:8081
LOCAL_API_MAX_FILE_SIZE_MB=2000
# Optional docker-compose.local-api.example.yml settings for an existing Local Bot API container
TELEGRAM_LOCAL_API_NETWORK=
TELEGRAM_LOCAL_API_BASE_URL=http://telegram-local-api:8081

# Default send mode: video | document
DEFAULT_SEND_MODE=document

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
LOG_DIR=./logs

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# Allowed redirect hops
MAX_REDIRECTS=10

# Queue safeguards include running/waiting jobs and apply to admins too
MAX_QUEUED_JOBS_PER_USER=3
MAX_TOTAL_QUEUED_JOBS=50
